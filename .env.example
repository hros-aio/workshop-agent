# Database (existing PostgreSQL)
WORKSHOP_DATABASE_URL=postgresql+psycopg://workshop:workshop@localhost:5432/hrms
WORKSHOP_DB_SCHEMA=workshop

# Redis (existing; Arq queue)
WORKSHOP_REDIS_URL=redis://localhost:6379/0

# Object storage (S3 / MinIO)
WORKSHOP_S3_ENDPOINT_URL=http://localhost:9000
WORKSHOP_S3_REGION=us-east-1
WORKSHOP_S3_ACCESS_KEY_ID=minioadmin
WORKSHOP_S3_SECRET_ACCESS_KEY=minioadmin
WORKSHOP_S3_BUCKET=workshop
WORKSHOP_S3_PRESIGN_TTL_SECONDS=900
WORKSHOP_S3_FORCE_PATH_STYLE=true

# JWT (platform-issued; verify with shared secret OR JWKS)
WORKSHOP_JWT_SECRET=dev-secret-change-me
WORKSHOP_JWT_ALGORITHM=HS256
WORKSHOP_JWT_AUDIENCE=hrms-platform
WORKSHOP_JWT_ISSUER=hrms-auth
# WORKSHOP_JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# Kafka (outbound events only)
WORKSHOP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
WORKSHOP_KAFKA_ENABLED=false
WORKSHOP_KAFKA_TOPIC_PREFIX=workshop

# AI providers
WORKSHOP_OPENAI_API_KEY=
WORKSHOP_OPENAI_MODEL=gpt-4o-mini
WORKSHOP_QWEN_BASE_URL=http://localhost:8001/v1
WORKSHOP_QWEN_API_KEY=not-needed
WORKSHOP_QWEN_MODEL=Qwen3.5-27B

# Analysis tuning
WORKSHOP_DUPLICATE_SIMILARITY_THRESHOLD=90
WORKSHOP_ANALYSIS_TIMEOUT_SECONDS=600
WORKSHOP_AI_MAX_RETRIES=1
